	(text "PD = (Vin - Vout) * Imax = 1.7V * 0.16A = 0.272W\n(120-150mA from STM32H7 + op-amp ~= 160mA)\n\nFor SOT-23-5:\nΔT = Pd * R = 0.272W * 184C/W = 50C\n25C + 50C = 75C (150C max in datasheet)"
		(exclude_from_sim no)
		(at 50.292 129.032 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
